{% comment %}
  RAQI Redesign — §2.13 FAQ. Single-open accordion, item 1 open on load,
  whole row clickable, + / − in wine. Emits FAQPage structured data only
  where the section setting says to — see show_faq_schema below.
  Question 5 carries the corrected spray figures (170 / 360+).
{% endcomment %}
{% render 'rd-fonts' %}
<div class="rd-scope">
  <section class="rd-section rd-frame" aria-labelledby="rd-faq-h">
    <div class="rd-faq">
      <h2 class="rd-h2" id="rd-faq-h">{{ section.settings.heading }}</h2>
      <div data-rd-faq>
        {%- for block in section.blocks -%}
          {%- assign open = false -%}
          {%- if forloop.first -%}{%- assign open = true -%}{%- endif -%}
          <div class="rd-faq__item" {{ block.shopify_attributes }}>
            <button class="rd-faq__q" type="button" aria-expanded="{{ open }}" aria-controls="rd-faq-a-{{ forloop.index }}">
              <span>{{ block.settings.question }}</span>
              <span class="rd-faq__sign" aria-hidden="true">{% if open %}&minus;{% else %}&plus;{% endif %}</span>
            </button>
            <p class="rd-faq__a" id="rd-faq-a-{{ forloop.index }}" {% unless open %}hidden{% endunless %}>{{ block.settings.answer }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{%- comment -%}
  Structured data is deliberately emitted on ONE page only. Google treats the
  same FAQPage markup repeated across a site as duplicate content, which can
  cost the rich result sitewide rather than just on the copies. The visible
  accordion below renders on every instance regardless of this setting.
{%- endcomment -%}
{%- if section.settings.show_faq_schema -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<script>
(function () {
  var root = document.querySelector('[data-rd-faq]');
  if (!root) return;
  var btns = root.querySelectorAll('.rd-faq__q');
  for (var i = 0; i < btns.length; i++) {
    (function (btn) {
      btn.addEventListener('click', function () {
        var isOpen = btn.getAttribute('aria-expanded') === 'true';
        for (var j = 0; j < btns.length; j++) {
          var b = btns[j];
          var panel = document.getElementById(b.getAttribute('aria-controls'));
          var open = (b === btn) && !isOpen;
          b.setAttribute('aria-expanded', open ? 'true' : 'false');
          var sign = b.querySelector('.rd-faq__sign');
          if (sign) sign.innerHTML = open ? '&minus;' : '&plus;';
          if (panel) { if (open) { panel.removeAttribute('hidden'); } else { panel.setAttribute('hidden', ''); } }
        }
      });
    })(btns[i]);
  }
})();
</script>

{% schema %}
{
  "name": "RD FAQ", "tag": "section", "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "checkbox", "id": "show_faq_schema", "label": "Emit FAQ structured data (JSON-LD)", "default": false, "info": "Adds FAQPage schema for Google. Turn this on for ONE page only — the homepage. Duplicating it across product and collection pages can cost the rich result sitewide. The visible FAQ shows either way." }
  ],
  "blocks": [ { "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question" },
    { "type": "textarea", "id": "answer", "label": "Answer" } ] } ],
  "presets": [{ "name": "RD FAQ" }]
}
{% endschema %}
