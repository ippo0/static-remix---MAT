{% comment %} Raqi — generic centered page heading, ruled off {% endcomment %}
<div class="raqi-section raqi-hairline-bottom" style="padding:56px 0 40px;text-align:center;">
  <div class="raqi-container">
    {%- if section.settings.micro_label != blank -%}
      <div class="raqi-micro-label raqi-micro-label--accent">{{ section.settings.micro_label }}</div>
    {%- endif -%}
    <h1 style="font-family:var(--raqi-font-display);font-weight:400;font-size:42px;color:var(--raqi-ink);margin:16px 0 12px;">{{ section.settings.heading }}</h1>
    {%- if section.settings.subhead != blank -%}
      <p style="font-size:14px;line-height:1.8;color:var(--raqi-text-muted);max-width:560px;margin:0 auto;">{{ section.settings.subhead }}</p>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Raqi: Page Heading",
  "settings": [
    { "type": "text", "id": "micro_label", "label": "Micro label", "default": "Niche & designer fragrances" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All perfumes" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Everything we carry, on one page — every fragrance available in both 10 ml and 30 ml." }
  ],
  "presets": [ { "name": "Raqi: Page Heading" } ]
}
{% endschema %}
