{% comment %}
  Raqi — "How a decant is made" (design_spec_en.md section 2, item 4).
  Rebuilt 2026-08-02. 3-column grid, Roman numeral + micro-label + body per
  column. Copy is verbatim from the spec, exposed as settings so a later
  pass can translate it via the Translate & Adapt app (same mechanism used
  for other section-settings copy on this project).
  2026-08-12 update (Raqi box design system, item 3): added a thin linear
  icon inside a hairline circle above each step numeral — bottle (Sourced),
  pipette + droplet (Poured), wax stamp with checkmark (Sealed) — matching
  the site's existing 1.4px hairline stroke weight (same weight used by the
  globe icon in raqi-language-switcher.liquid and the hairline rules used
  throughout raqi-*.liquid). Purely decorative (aria-hidden), inline SVG so
  no extra asset requests.
  2026-08-13 update: step 3's label changed from "Worn" to "Sealed" (both
  here as the schema default and in templates/index.json's live instance)
  to match the wax-stamp-with-checkmark icon concept from the brief.
{% endcomment %}
<section class="raqi-steps raqi-section" id="raqi-steps">
  <div class="raqi-container">
    <h2 class="raqi-steps__heading">{{ section.settings.heading }}</h2>
    <div class="raqi-steps__grid">
      <div class="raqi-steps__col">
        <span class="raqi-steps__icon-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 2h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M10.5 2v3.2c0 .5-.16.98-.46 1.38L8.6 8.5c-.65.87-1 1.93-1 3.02V19a2 2 0 0 0 2 2h4.8a2 2 0 0 0 2-2v-7.48c0-1.09-.35-2.15-1-3.02l-1.44-1.92c-.3-.4-.46-.88-.46-1.38V2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M8 14.5h8" stroke="currentColor" stroke-width="1.4"/>
          </svg>
        </span>
        <p class="raqi-steps__numeral">{{ section.settings.step_1_numeral }}</p>
        <p class="raqi-steps__label">{{ section.settings.step_1_label }}</p>
        <p class="raqi-steps__body">{{ section.settings.step_1_body }}</p>
      </div>
      <div class="raqi-steps__col">
        <span class="raqi-steps__icon-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 3l6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M9.5 2.5l4 4-1.2 1.2a2.5 2.5 0 0 1-3.5 0l-.5-.5a2.5 2.5 0 0 1 0-3.5L9.5 2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M12 9l-5.2 5.2c-.9.9-1.4 2.13-1.4 3.4v.4a2 2 0 0 0 2 2h.4c1.27 0 2.5-.5 3.4-1.4L16.4 13.6" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <circle cx="17.5" cy="18.5" r="1.6" stroke="currentColor" stroke-width="1.4"/>
          </svg>
        </span>
        <p class="raqi-steps__numeral">{{ section.settings.step_2_numeral }}</p>
        <p class="raqi-steps__label">{{ section.settings.step_2_label }}</p>
        <p class="raqi-steps__body">{{ section.settings.step_2_body }}</p>
      </div>
      <div class="raqi-steps__col">
        <span class="raqi-steps__icon-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3l7 3.2v4.3c0 4.5-3 8.5-7 9.5-4-1-7-5-7-9.5V6.2L12 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M9 12.3l2 2 4-4.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <p class="raqi-steps__numeral">{{ section.settings.step_3_numeral }}</p>
        <p class="raqi-steps__label">{{ section.settings.step_3_label }}</p>
        <p class="raqi-steps__body">{{ section.settings.step_3_body }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .raqi-steps__icon-circle{
    display:flex;align-items:center;justify-content:center;
    width:56px;height:56px;border-radius:50%;
    border:1px solid var(--raqi-rule);
    color:var(--raqi-accent);
    margin:0 0 18px;
  }
  .raqi-steps__col{ display:flex;flex-direction:column;align-items:flex-start; }
</style>

{% schema %}
{
  "name": "Raqi: Decant steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a decant is made" },
    { "type": "text", "id": "step_1_numeral", "label": "Step 1 numeral", "default": "I" },
    { "type": "text", "id": "step_1_label", "label": "Step 1 label", "default": "Sourced" },
    { "type": "textarea", "id": "step_1_body", "label": "Step 1 body", "default": "We buy full bottles at retail from authorised UAE agents — and we can show you the one yours came from." },
    { "type": "text", "id": "step_2_numeral", "label": "Step 2 numeral", "default": "II" },
    { "type": "text", "id": "step_2_label", "label": "Step 2 label", "default": "Poured" },
    { "type": "textarea", "id": "step_2_body", "label": "Step 2 body", "default": "Into sealed glass atomisers, filled the day your order leaves us and labelled with the brand, the name and the date." },
    { "type": "text", "id": "step_3_numeral", "label": "Step 3 numeral", "default": "III" },
    { "type": "text", "id": "step_3_label", "label": "Step 3 label", "default": "Sealed" },
    { "type": "textarea", "id": "step_3_body", "label": "Step 3 body", "default": "Weeks of wearing it out — to work, to dinner, through a Gulf summer — before you commit to a full bottle. That's the only test that tells you anything." }
  ]
}
{% endschema %}
