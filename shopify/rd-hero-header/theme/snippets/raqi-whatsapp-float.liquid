{% style %}
  .raqi-wa-float { display: none; }

  @media (max-width: 900px) {
    .raqi-wa-float {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      inset-inline-end: 16px;
      inset-block-end: calc(16px + env(safe-area-inset-bottom, 0px));
      z-index: 500;
      inline-size: 52px;
      block-size: 52px;
      border-radius: 50%;
      background: #25D366;
      color: #fff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
      transition: transform 150ms ease;
    }

    .raqi-wa-float svg {
      inline-size: 28px;
      block-size: 28px;
      display: block;
    }

    .raqi-wa-float:active { transform: scale(0.94); }

    .raqi-wa-float:focus-visible {
      outline: 2px solid var(--rd-ink, #22261F);
      outline-offset: 3px;
    }

    /* Clear the product page's sticky Add-to-Cart bar (59px tall, z-index 30). */
    body.template-product .raqi-wa-float {
      inset-block-end: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .raqi-wa-float { transition: none; }
    .raqi-wa-float:active { transform: none; }
  }
{% endstyle %}
