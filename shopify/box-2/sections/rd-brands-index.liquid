{% comment %}
  RAQI Redesign — Brands index, the page behind header nav "Brands"
  (routes.collections_url → templates/list-collections.json).

  Uses the same house-card treatment as §3.4 "Shop by brand" on the homepage,
  so the two surfaces cannot drift apart. Houses are chosen per block, which
  keeps utility collections — Men, Women, Unisex, Niche, Best Sellers and
  Quantity Discount Eligible — off a page that is meant to be houses only.

  A block with no collection selected renders as an inert placeholder rather
  than a link to nowhere.

  2026-08-30: cards no longer require an image. A block without one renders as
  a text card (rd-house--text) instead of the "House imagery pending" plate.
  That needs its own colours: the image card's name and count are --rd-bone,
  legible only over a photograph and its scrim, and would be invisible against
  the bare --rd-panel card. The overrides live in this file's style block so
  assets/raqi-redesign.css stays untouched.
{% endcomment %}
{% render 'rd-fonts' %}
<div class="rd-scope">
  <section class="rd-section rd-frame rd-bidx" aria-labelledby="rd-bidx-h">
    <div class="rd-bidx__head">
      <h1 class="rd-bidx__h1" id="rd-bidx-h">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="rd-bidx__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="rd-houses__grid rd-bidx__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign count = col.all_products_count
          assign name = block.settings.name_override | default: col.title
          assign unit = section.settings.count_plural
          if count == 1
            assign unit = section.settings.count_singular
          endif
        -%}
        {%- if col != blank and col.handle != blank -%}
          {%- liquid
            assign card_class = 'rd-house rd-house--text'
            if block.settings.image != blank
              assign card_class = 'rd-house'
            endif
          -%}
          <a class="{{ card_class }}" href="{{ col.url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img class="rd-house__img"
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 900px) 50vw, 33vw"
                alt="{{ block.settings.image_alt | default: name | escape }}"
                width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                loading="lazy">
              <span class="rd-house__scrim"></span>
            {%- endif -%}
            <span class="rd-house__text">
              <span class="rd-house__name">{{ name }}</span>
              <span class="rd-house__count">{{ count }} {{ unit }}</span>
            </span>
          </a>
        {%- else -%}
          <div class="rd-house rd-house--empty" {{ block.shopify_attributes }}>
            <span class="rd-house__ph">Select a collection</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</div>

{% style %}
  /* The shared grid collapses to a horizontal scroll strip below 900px, which
     suits six curated houses but not a full brand directory. Keep it a wrapping
     grid at every width. */
  .rd-bidx__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px; overflow: visible; margin-inline: 0; padding-inline: 0; }

  /* 2026-09-05 uneven-card fix. The card height used to be block-size:auto, so a
     card was exactly as tall as its brand name: "Creed" gave a short box and
     "Maison Francis Kurkdjian" wrapped to two lines and gave a tall one, in a
     grid where every row is as tall as its tallest card. The height is now
     fixed and the name clamps inside it instead of pushing it open.

     116px is the shortest comfortable height, not an arbitrary one:
     20+20 padding + 2 border + two 22px name lines at 1.15 (50.6) + the count
     (12) and its 8px stand-off = 113. The remaining 3px keeps a two-line name
     off the count's shoulder. Two lines because that is what the longest real
     house name needs; clamping to one would truncate "Maison Francis
     Kurkdjian" mid-word. */
  .rd-bidx__grid .rd-house--text {
    block-size: 116px;
    inline-size: auto;
    flex: initial;
    display: flex;
    align-items: stretch;
    justify-content: flex-start;
    gap: 0;
    padding: 20px 22px;
    background: var(--rd-panel);
    border: 1px solid var(--rd-rule);
    transition: border-color 200ms ease;
  }

  /* Fills the fixed card so the count can be pushed to the bottom edge: every
     card's count then sits on the same baseline regardless of name length. */
  .rd-bidx__grid .rd-house--text .rd-house__text {
    position: static;
    padding: 0;
    inline-size: 100%;
    block-size: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Clamped, not truncated: two lines cover every house in the catalogue.
     .rd-house already carries overflow:hidden, so a browser that ignores
     line-clamp crops the overflow rather than bursting the card. */
  .rd-bidx__grid .rd-house--text .rd-house__name {
    color: var(--rd-ink);
    font-size: 22px;
    line-height: 1.15;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  /* Not var(--rd-grey): #6B6F66 on the --rd-panel card is 4.26:1, under the 4.5
     AA floor for text this small. #565A51 is the same hue a shade darker, 5.85:1.
     The token itself is left alone — it passes on the page ground it is used on
     elsewhere; only this pairing was short. */
  /* 2026-09-05: the base .rd-house__count is uppercase, which is right for a
     micro-label sitting over a photograph but shouts beside a quiet brand name
     on a bare panel. Rendered as authored instead: "5 fragrances".

     The base 0.18em tracking goes with it. That figure was set for uppercase,
     where wide letter-spacing is what makes a micro-label legible; on lowercase
     it just reads loose. 0.04em keeps a trace of the label character without
     spacing the word out. Set once here rather than per breakpoint — the 900px
     block only changes font-size, so this value carries down to 375px. */
  .rd-bidx__grid .rd-house--text .rd-house__count {
    color: #565A51; font-size: 10px; line-height: 1.2; white-space: nowrap;
    text-transform: none; letter-spacing: 0.04em;
    margin-block-start: auto; padding-block-start: 8px;
  }

  .rd-bidx__grid .rd-house--text:hover { border-color: var(--rd-wine); }
  .rd-bidx__grid .rd-house--text:hover .rd-house__name { color: var(--rd-wine); }

  @media (max-width: 900px) {
    .rd-bidx__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    /* Same arithmetic at the smaller type: 15+15 padding + 2 border + two 18px
       lines at 1.15 (41.4) + the 9px count (11) and its 8px stand-off = 93,
       rounded to 96. This block also governs 375px, where the grid is a single
       column and most names fit on one line — the height stays fixed anyway so
       the column reads as an even stack. */
    .rd-bidx__grid .rd-house--text { block-size: 96px; padding: 15px 16px; }
    .rd-bidx__grid .rd-house--text .rd-house__name { font-size: 18px; }
    .rd-bidx__grid .rd-house--text .rd-house__count { font-size: 9px; }
  }

  @media (max-width: 460px) {
    .rd-bidx__grid { grid-template-columns: 1fr; }
  }
{% endstyle %}

{% schema %}
{
  "name": "RD Brands index",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The houses" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Every fragrance we decant comes from a house worth knowing. Start with the one that draws you." },
    { "type": "text", "id": "count_singular", "label": "Count word (singular)", "default": "fragrance" },
    { "type": "text", "id": "count_plural", "label": "Count word (plural)", "default": "fragrances" }
  ],
  "blocks": [
    {
      "type": "house",
      "name": "House",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "name_override", "label": "Display name", "info": "Falls back to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [{ "name": "RD Brands index" }]
}
{% endschema %}
