    { "type": "text", "id": "returns_label", "label": "⚠️ Returns line label (legally sensitive)", "default": "Returns —", "info": "Legally sensitive — this label and the Returns line body below combine into the published return policy sentence. Read the warning on the field below before changing either one." },
    { "type": "textarea", "id": "returns_body", "label": "⚠️ Returns line body (legally sensitive)", "default": "unopened decants can be returned within 14 days for a full refund. Opened decants can't be resold, so we can't take them back — but if something arrives damaged or isn't what you ordered, message us and we'll replace it.", "info": "⚠️ LEGALLY SENSITIVE — return policy wording. Any rewrite/republish of templates/product.json must manually verify this text has not reverted to an older or auto-translated version before publishing: it reverted silently on 2026-08-02 when the block's instance ID changed during a template rewrite. The Arabic is a Translate & Adapt override tied to this exact English string, so editing either orphans it with no error. Full warning + approved Arabic: see sections/raqi-product.liquid." },
    { "type": "text", "id": "ship_footnote_pre", "label": "Footnote prefix", "default": "Questions?" },
    { "type": "text", "id": "ship_footnote_whatsapp", "label": "Footnote WhatsApp link text", "default": "Contact us on WhatsApp" },
    { "type": "text", "id": "ship_footnote_or", "label": "Footnote joiner", "default": "or read the full" },
    { "type": "text", "id": "ship_footnote_policy", "label": "Footnote policy link text", "default": "Shipping Policy" },
    { "type": "text", "id": "product_info_label", "label": "Product Information label", "default": "Product Information" }
  ]
