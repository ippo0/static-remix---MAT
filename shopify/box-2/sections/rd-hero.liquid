{% comment %}
  RAQI Redesign — §3A Homepage hero. LOCKED, signed off. Do not restyle.

  Single static composition. No carousel, no rotation, no dot indicators.
  The ENTIRE hero — both columns — is one click target linking to the Discovery
  Set builder at /pages/discovery-box.

  NOTE: that page is currently unpublished, so this link 404s until the box
  arrives and the page is published. That is expected and is why this theme must
  not be published yet (§8.1).

  Price card carries NO struck-through price, NO percentage, NO "save" language —
  removed deliberately for conflicting with §8.7. Do not reinstate.

  Everything is an editable setting so copy, price and image can be changed from
  the theme customizer without a developer.
{% endcomment %}
{% render 'rd-fonts' %}
<div class="rd-scope">
  <a class="rd-hero" href="{{ section.settings.link | default: '/pages/discovery-box' }}">
    <div class="rd-hero__copy">
      <p class="rd-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="rd-hero__h1">{{ section.settings.heading }}</h1>
      <p class="rd-hero__body">{{ section.settings.body }}</p>

      {%- if section.settings.show_offer -%}
        <div class="rd-hero__offer">
          <span class="rd-hero__offer-price">{{ section.settings.offer_price }}</span>
          {%- if section.settings.offer_breakdown != blank -%}
            <p class="rd-hero__offer-break">{{ section.settings.offer_breakdown }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="rd-hero__cta">
        {%- for block in section.blocks -%}
          {%- if block.type == 'cta' -%}
            {%- liquid
              assign klass = 'rd-btn rd-btn--ghost'
              if block.settings.style == 'primary'
                assign klass = 'rd-btn rd-btn--primary'
              endif
            -%}
            <span class="{{ klass }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.step_line != blank -%}
        <p class="rd-hero__steps">{{ 'raqi.rd.hero.try_it' | t }} <span>&rarr;</span> {{ 'raqi.rd.hero.live_with_it' | t }} <span>&rarr;</span> {{ 'raqi.rd.hero.decide' | t }}</p>
      {%- endif -%}
    </div>

    <div class="rd-hero__panel">
      <div class="rd-hero__frame">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}"
               srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 800 }} 800w"
               sizes="(max-width: 900px) 240px, 340px"
               alt="{{ section.settings.image_alt | escape }}"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
               loading="eager" fetchpriority="high">
        {%- else -%}
          <span class="rd-hero__oval" aria-hidden="true">
            <span class="rd-hero__oval-en">RAQI</span>
            <span class="rd-hero__oval-ar" lang="ar">راقي</span>
          </span>
          <span class="rd-hero__bottles" aria-hidden="true">
            <span class="rd-hero__bottle"></span><span class="rd-hero__bottle"></span><span class="rd-hero__bottle"></span>
          </span>
          <span class="rd-visually-hidden">{{ section.settings.image_alt }}</span>
        {%- endif -%}
      </div>
    </div>
  </a>
</div>

{% schema %}
{
  "name": "RD Hero",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "url", "id": "link", "label": "Hero link", "info": "The whole hero is one click target. Defaults to the Discovery Set builder." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RAQI Discovery Set" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "No one should buy a signature in two minutes." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Choose 1 Signature + 2 Discovery fragrances — 15ml each, 45ml total. Experience three original fragrances before committing to a full bottle." },
    { "type": "text", "id": "step_line", "label": "Show step line", "default": "yes", "info": "Clear this field to hide the Try it → Live with it → Decide line." },
    { "type": "header", "content": "Price card" },
    { "type": "checkbox", "id": "show_offer", "label": "Show price card", "default": true },
    { "type": "text", "id": "offer_price", "label": "Price", "default": "Dhs. 599" },
    { "type": "text", "id": "offer_breakdown", "label": "Detail line", "default": "Three fragrances · 45ml · Individually Dhs. 850" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Discovery Set box photograph", "info": "Pending from the manufacturer. Until set, the placeholder frame renders — never stock photography." },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "The RAQI Discovery Set box" }
  ],
  "blocks": [
    { "type": "cta", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Build Your Set" },
      { "type": "select", "id": "style", "label": "Style", "default": "primary",
        "options": [ { "value": "primary", "label": "Filled (wine)" }, { "value": "secondary", "label": "Outlined" } ] }
    ] }
  ],
  "presets": [{ "name": "RD Hero" }]
}
{% endschema %}
