    "raqi_story_sizes": {
      "type": "raqi-story-sizes",
      "settings": {
        "story_eyebrow": "Our Story",
        "story_heading_line_1": "Why commit to a fragrance",
        "story_heading_line_2": "before you know it's yours?",
        "story_body_1": "A bottle of Amouage or Roja can cost more than a month's rent — and two minutes with a paper strip under mall lighting won't tell you how it wears on your skin, in your climate, over a real day. So we stopped guessing. We buy the bottles ourselves from authorised UAE agents, pour them into 10ml and 30ml glass, and let you actually live with a fragrance before you spend on the full bottle.",
        "story_body_2": "Every fragrance we sell is 100% authentic, bought from authorised agents here in the UAE — never a copy, never an \"inspired by\". If you ever want to see the bottle yours was poured from, just ask; we'll send you a photo of it the same day.",
        "story_tag_1": "Authorised agents",
        "story_tag_2": "Guaranteed original",
        "story_tag_3": "Filled in the UAE",
        "sizes_heading": "10 ml or 30 ml?",
        "sizes_subhead": "The same fragrance, the same batch — only the amount of liquid changes.",
        "reference_product": "",
        "ten_label": "10 ml",
        "ten_sprays": "≈ 170 sprays",
        "ten_body": "About six weeks of daily wear, and small enough for a jacket pocket. The right way to get to know something new.",
        "thirty_label": "30 ml",
        "thirty_sprays": "≈ 360+ sprays",
        "thirty_body": "Four to six months of wear and the lowest price per millilitre we offer. For the one you already know is yours.",
        "sizes_tag_1": "Same juice",
        "sizes_tag_2": "Same batch",
        "sizes_tag_3": "Sealed glass atomiser"
      }
    },
    "rd_faq": {
      "type": "rd-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "What exactly is a decant?",
            "answer": "Fragrance transferred by hand from a sealed, authenticated full bottle into a smaller glass atomiser. Same fragrance, same batch, a size you can finish."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Is the fragrance authentic?",
            "answer": "Yes. Every bottle is bought through authorised UAE agents and its batch code is recorded before we pour. The code is printed on your label so you can verify it yourself."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Where do you source your fragrances?",
            "answer": "Authorised agents and distributors in the UAE. We never buy unsealed stock and we never buy from unverified resellers."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Why buy a decant instead of a full bottle?",
            "answer": "A full bottle costs AED 1,000–1,500. A decant lets you wear the fragrance for weeks first. If it is yours, buy the bottle. If it is not, you have spent a fraction of that finding out."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Why 10ml and 30ml?",
            "answer": "10ml is about 170 sprays, enough to know. 30ml is about 360+ sprays, enough to wear a fragrance through a season before committing. We do not sell 3ml or 5ml sizes."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "How is the fragrance transferred?",
            "answer": "By hand, in a controlled space, using sterilised equipment and pharmaceutical-grade glass atomisers. Nothing is diluted, heated, or mixed. Each order is poured and sealed the same day it ships."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "Can I see a photo of the source bottle or batch date?",
            "answer": "Yes. Ask us before or after you order and we will send a photo of the bottle your decant was filled from, including its batch code and date."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "What is the Discovery Set?",
            "answer": "Three fragrances you choose yourself, poured at 15ml each into the RAQI box. It is built by you, not a fixed sampler. Arriving soon."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "question": "How is the Discovery Set different from a normal decant?",
            "answer": "A decant is one fragrance at 10ml or 30ml. The Discovery Set is three fragrances at 15ml each in a presentation box, made for deciding between houses rather than living with one."
          }
        }
      },
